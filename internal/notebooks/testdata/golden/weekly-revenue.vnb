{
  "schemaVersion": 2,
  "title": "Weekly revenue",
  "cells": [
    {
      "id": "cell_1",
      "type": "sql",
      "collapsed": false,
      "source": "SELECT region, sum(amt) AS total\nFROM orders\nWHERE amt > 10 AND note <> '<b>&</b>'\nGROUP BY 1",
      "view": "bar",
      "viewPinned": true,
      "label": "By region",
      "connection": "local"
    },
