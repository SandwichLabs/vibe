{
  // Specs only: the same compiler options plus Node types (process, Buffer, fs).
  // Views and libs are checked by tsconfig.json, which has no Node types.
  "extends": "./tsconfig.json",
  "compilerOptions": { "types": ["vite/client", "node"] },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"],
  "exclude": ["src/wailsjs/go"]
}
