[Desktop Entry]
Type=Application
Name=Assay
GenericName=Data workspace
Comment=An agentic workspace for working with data where it lives
Exec=assay-studio %U
Icon=assay
Terminal=false
Categories=Development;Database;
# Only .assay bundles are claimed. inode/directory is deliberately not listed:
# it would put Assay in "Open With" (and sometimes the default-handler list) for
# every folder on the machine. A workspace folder opens with
# `assay-studio <dir>` or `assay studio --gui <dir>`; see docs/packaging.md.
MimeType=application/x-assay-bundle;
StartupWMClass=assay-studio
Keywords=data;sql;duckdb;notebook;workspace;
